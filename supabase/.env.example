# SUPABASE SERVER-SIDE SECRETS & ENVIRONMENT CONFIGURATION
# Set these secrets using the Supabase CLI (`supabase secrets set KEY=VALUE`) or Supabase Dashboard.
# NEVER expose these in client-side bundles or repository commits.

# 1. Supabase Project Secret Credentials (Server-Side Edge Functions Only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-supabase-jwt-secret

# 2. Designated Administrator Email Whitelist
AUTHORIZED_ADMIN_EMAIL=Tanishksinghal6285@gmail.com

# 3. GitHub App Credentials (Server-Side Publishing Pipeline)
# Permission Required: "Contents: Read & Write" on Tanishk756/tanishksinghal.github.io
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=78901234
GITHUB_APP_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# 4. Target Repository
GITHUB_REPO_OWNER=Tanishk756
GITHUB_REPO_NAME=tanishksinghal.github.io
GITHUB_REPO_BRANCH=main

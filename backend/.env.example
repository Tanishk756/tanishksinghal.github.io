# PRIVATE BACKEND ENVIRONMENT CONFIGURATION (SERVER-SIDE ONLY)
# Never commit actual secret values to source control.
# Set these variables using Cloudflare Dashboard or `npx wrangler secret put <NAME>`

# 1. Cloudflare D1 Database ID
CLOUDFLARE_D1_DATABASE_ID=your-cloudflare-d1-uuid-here

# 2. Cloudflare Access Zero Trust Configuration
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD_TAG=your-cloudflare-access-application-aud-tag
AUTHORIZED_EMAILS=Tanishksinghal6285@gmail.com

# 3. Private GitHub App Credentials (Server-Side Publishing Pipeline)
# Requires Repository Permission: "Contents: Read & Write"
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=78901234
GITHUB_APP_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# 4. Target GitHub Repository
GITHUB_REPO_OWNER=Tanishk756
GITHUB_REPO_NAME=tanishksinghal.github.io
GITHUB_REPO_BRANCH=main

# 5. Local Development Testing Token (Optional for running backend tests locally)
DEV_ADMIN_BEARER_TOKEN=dev-secret-local-token

# PUBLIC FRONTEND ENVIRONMENT VARIABLES
# CRITICAL SECURITY NOTE: Everything starting with VITE_ is bundled into client-side JS.
# NEVER place GitHub PATs, GitHub App private keys, or database service-role credentials here!

# 1. Public Portfolio Deployment Origin (GitHub Pages)
VITE_PUBLIC_SITE_URL=https://tanishksinghal.github.io

# 2. Supabase Backend Configuration (Browser-Safe Anon Key & Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. CMS Backend Mode ('supabase' by default, or 'local' for offline prototype development)
VITE_CMS_BACKEND=supabase

# 4. Private CMS Backend API URL (Supabase Edge Function Base or Cloudflare Worker fallback)
VITE_CMS_API_URL=https://your-project-ref.supabase.co/functions/v1

# 5. Direct Google Calendar Booking Schedule URL (Public Appointment Schedule)
VITE_GOOGLE_BOOKING_URL=https://calendar.app.google/Ww3ThqpzmeW4FoHUA



